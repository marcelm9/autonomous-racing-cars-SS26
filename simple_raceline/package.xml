<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simple_raceline</name>
  <version>0.0.2</version>
  <description>A simple raceline generator used as a planner example for ARC course.</description>
  <maintainer email="jaroslav.klapalek@tuwien.ac.at">Jaroslav Klapálek</maintainer>
  <license>GPLv3</license>

  <depend>rclpy</depend>
  <depend>python3-numpy</depend>
  <depend>python-skimage-pip</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rcl_interfaces</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
