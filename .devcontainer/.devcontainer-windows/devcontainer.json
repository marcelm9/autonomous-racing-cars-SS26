{
    "name": "ROS 2 Development Container",
    "privileged": true,
    "remoteUser": "${localEnv:USER}",
    "build": {
        "dockerfile": "../../Dockerfile",
        "args": {
            "USERNAME": "${localEnv:USER}"
        }
    },
    "workspaceFolder": "/arc2026/ws/",
    "workspaceMount": "source=${localWorkspaceFolder}/src,target=/arc2026/ws/src/your_code,type=bind",
    "customizations": {
        "vscode": {
            "extensions":[
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "eamodio.gitlens",
                "ms-iot.vscode-ros"
            ]
        }
    },
    "containerEnv": {
        "DISPLAY": "host.docker.internal:0",
        "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST",
        "ROS_DOMAIN_ID": "42",
    },
    "runArgs": [
        "--add-host", "host.docker.internal:host-gateway",
        "-e", "DISPLAY=host.docker.internal:0",
        "-p", "3000:3000"
    ],
    "mounts": [
        "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached",
        "source=${localWorkspaceFolder}/.cache/jazzy/build,target=/arc2026/ws/build,type=bind",
        "source=${localWorkspaceFolder}/.cache/jazzy/install,target=/arc2026/ws/install,type=bind",
        "source=${localWorkspaceFolder}/.cache/jazzy/log,target=/arc2026/ws/log,type=bind",
        "source=${localWorkspaceFolder}/maps,target=/arc2026/maps,type=bind",
        "source=${localWorkspaceFolder}/get_env.sh,target=/usr/bin/get_env,type=bind"
    ],
    "postCreateCommand": "rosdep update --rosdistro jazzy && rosdep install --from-paths src/your_code --ignore-src --rosdistro jazzy -y && sudo chown -R ${localEnv:USER} /arc2026/ws/"
}
